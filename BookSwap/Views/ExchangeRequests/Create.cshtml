@model BookSwap.Models.ExchangeRequest

@{
    ViewData["Title"] = "Create Exchange Request";
}

<h1>Create</h1>

<h4>Exchange Request</h4>
<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="OfferedBookId"
                       class="control-label">
                    Book you offer
                </label>

                <select asp-for="OfferedBookId"
                        class="form-control"
                        asp-items="ViewBag.OfferedBookId">

                    <option value="">
                        -- Select a book --
                    </option>

                </select>

                <span asp-validation-for="OfferedBookId"
                      class="text-danger"></span>
            </div>


            <div class="form-group mb-3">
                <label asp-for="RequestedBookId"
                       class="control-label">
                    Book you want
                </label>

                <select asp-for="RequestedBookId"
                        class="form-control"
                        asp-items="ViewBag.RequestedBookId">

                    <option value="">
                        -- Select a book --
                    </option>

                </select>

                <span asp-validation-for="RequestedBookId"
                      class="text-danger"></span>
            </div>


            <div class="form-group">
                <input type="submit"
                       value="Create"
                       class="btn btn-primary" />
            </div>

        </form>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}